{
  "name": "kartenwerk",
  "version": "0.1.0",
  "private": true,
  "description": "Karteneditor für deutsche Politik: Wahlkreise einfärben, beschriften und für Social Media exportieren.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode preview && node scripts/inline-preview.mjs",
    "geodata": "node scripts/build-geodata.mjs",
    "typecheck": "tsc --noEmit",
    "orte": "esbuild scripts/build-orte.ts --bundle --platform=node --format=esm --packages=external --outfile=data-src/.tmp/build-orte.mjs --log-level=warning && node data-src/.tmp/build-orte.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "immer": "^10.2.0",
    "opentype.js": "1.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "0.18.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/opentype.js": "*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.21.5",
    "mapshaper": "^0.6.0",
    "polylabel": "^1.1.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
